# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# Paystack Configuration
# Get your keys from: https://dashboard.paystack.com/#/settings/developers
# Use sk_test_* for testing, sk_live_* for production
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# Application Configuration
ORIGIN=http://localhost:5173
NODE_ENV=development

# Axene Mailer
# Get your key from the Axene dashboard. Keep the real value in .env only.
AXENE_MAILER_API_KEY=axm_k_your_axene_mailer_key_here

# Secret used to sign OTP tokens and the admin session cookie.
# Generate one with: openssl rand -hex 32
OTP_SECRET=your_random_32_byte_hex_secret_here
