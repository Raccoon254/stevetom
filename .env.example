# Paystack Configuration
# Get your keys from: https://dashboard.paystack.com/#/settings/developers
# Use sk_test_* for testing, sk_live_* for production
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# Application Configuration
ORIGIN=http://localhost:5173
NODE_ENV=development

# Axene Mailer
# Get your key from the Axene dashboard. Keep the real value in .env only.
AXENE_MAILER_API_KEY=axm_k_your_axene_mailer_key_here

# Secret used to sign OTP tokens and the admin session cookie.
# Generate one with: openssl rand -hex 32
OTP_SECRET=your_random_32_byte_hex_secret_here

# Analytics
# Salt for the daily visitor hash. It is mixed with the UTC date, so the hash
# rotates every day and no raw IP address is ever stored. Optional: OTP_SECRET
# is used if this is unset.
# Generate one with: openssl rand -hex 32
ANALYTICS_SALT=your_random_32_byte_hex_secret_here

# Axene Mailer delivery webhook.
# Axene signs every webhook delivery with HMAC-SHA256 keyed by this secret, in
# the X-Axene-Signature header. The value is shown exactly once, when the
# webhook is created in the Axene Mailer dashboard (mail.axene.io -> Webhooks).
# Without it /api/webhooks/axene-mailer rejects every delivery with 401.
# Register the endpoint as: https://kentom.co.ke/api/webhooks/axene-mailer
AXENE_MAILER_WEBHOOK_SECRET=your_axene_webhook_signing_secret_here
